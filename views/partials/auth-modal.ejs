              required
              autocomplete="email"
              class="form-control"
            >
          </div>
          
          <div class="form-group">
            <label for="registerPassword">Password</label>
            <input 
              type="password" 
              id="registerPassword" 
              name="password" 
              placeholder="Create a password (min 6 characters)"
