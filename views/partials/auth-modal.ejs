<script>
  // Global variables to store temporary data
  let loginPhoneNumber = '';
  let registerFormData = {};
  let loginOtpTimer = null;
  let registerOtpTimer = null;
  
  // Open/Close Login Modal
  function openLoginModal() {
    document.getElementById('loginModal').classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  
  function closeLoginModal() {
    document.getElementById('loginModal').classList.remove('active');
    document.body.style.overflow = '';
    resetLoginModal();
  }
  
  function resetLoginModal() {
    document.getElementById('loginPhoneStep').classList.add('active');
    document.getElementById('loginOtpStep').classList.remove('active');
    document.getElementById('loginPhoneForm').reset();
    document.getElementById('loginOtpForm').reset();
    clearInterval(loginOtpTimer);
  }
  
  // Open/Close Register Modal
  function openRegisterModal() {
    document.getElementById('registerModal').classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  
  function closeRegisterModal() {
    document.getElementById('registerModal').classList.remove('active');
    document.body.style.overflow = '';
    resetRegisterModal();
  }
  
  function resetRegisterModal() {
    document.getElementById('registerPhoneStep').classList.add('active');
    document.getElementById('registerOtpStep').classList.remove('active');
    document.getElementById('registerPhoneForm').reset();
    document.getElementById('registerOtpForm').reset();
    clearInterval(registerOtpTimer);
  }
  
  // Switch between Login and Register
  function switchToRegister() {
    closeLoginModal();
    setTimeout(openRegisterModal, 300);
  }
  
  function switchToLogin() {
    closeRegisterModal();
    setTimeout(openLoginModal, 300);
  }
  
  // OTP Input Auto-focus
  function setupOTPInputs(container) {
    const inputs = container.querySelectorAll('.otp-digit');
    inputs.forEach((input, index) => {
      input.addEventListener('input', (e) => {
        if (e.target.value.length === 1 && index < inputs.length - 1) {
          inputs[index + 1].focus();
        }
      });
      
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !e.target.value && index > 0) {
          inputs[index - 1].focus();
        }
      });
      
      input.addEventListener('paste', (e) => {
        e.preventDefault();
        const pastedData = e.clipboardData.getData('text').slice(0, 6);
        pastedData.split('').forEach((char, i) => {
          if (inputs[i] && /[0-9]/.test(char)) {
            inputs[i].value = char;
          }
        });
        if (inputs[Math.min(pastedData.length, 5)]) {
          inputs[Math.min(pastedData.length, 5)].focus();
        }
      });
    });
  }
  
  // Initialize OTP inputs on page load
  document.addEventListener('DOMContentLoaded', () => {
    setupOTPInputs(document.getElementById('loginOtpStep'));
    setupOTPInputs(document.getElementById('registerOtpStep'));
  });
  
  // Login OTP Flow
  async function sendLoginOTP(e) {
    e.preventDefault();
    const phone = document.getElementById('loginPhone').value;
    
    if (phone.length !== 10) {
      alert('Please enter a valid 10-digit phone number');
      return;
    }
    
    loginPhoneNumber = phone;
    showLoader('loginPhoneBtn', 'loginPhoneLoader');
    
    try {
      const response = await fetch('/auth/send-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone })
      });
      
      const data = await response.json();
      
      if (data.success) {
        document.getElementById('loginPhoneDisplay').textContent = '+91 ' + phone;
        document.getElementById('loginPhoneStep').classList.remove('active');
        document.getElementById('loginOtpStep').classList.add('active');
        startOTPTimer('loginOtpTimer', 'loginResendBtn', 30);
        document.querySelector('#loginOtpStep .otp-digit').focus();
      } else {
        alert(data.message || 'Failed to send OTP. Please try again.');
      }
    } catch (error) {
      console.error('Error:', error);
      alert('An error occurred. Please try again.');
    } finally {
      hideLoader('loginPhoneBtn', 'loginPhoneLoader');
    }
  }
  
  async function verifyLoginOTP(e) {
    e.preventDefault();
    const otpInputs = document.querySelectorAll('#loginOtpStep .otp-digit');
    const otp = Array.from(otpInputs).map(input => input.value).join('');
    
    if (otp.length !== 6) {
      alert('Please enter the 6-digit OTP');
      return;
    }
    
    showLoader('loginOtpBtn', 'loginOtpLoader');
    
    try {
      const response = await fetch('/auth/verify-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone: loginPhoneNumber, otp })
      });
      
      const data = await response.json();
      
      if (data.success) {
        alert('Login successful!');
        closeLoginModal();
        location.reload();
      } else {
        alert(data.message || 'Invalid OTP. Please try again.');
        otpInputs.forEach(input => input.value = '');
        otpInputs[0].focus();
      }
    } catch (error) {
      console.error('Error:', error);
      alert('An error occurred. Please try again.');
    } finally {
      hideLoader('loginOtpBtn', 'loginOtpLoader');
    }
  }
  
  function changeLoginNumber() {
    document.getElementById('loginOtpStep').classList.remove('active');
    document.getElementById('loginPhoneStep').classList.add('active');
    clearInterval(loginOtpTimer);
  }
  
  async function resendLoginOTP() {
    await sendLoginOTP({ preventDefault: () => {} });
  }
  
  // Register OTP Flow
  async function sendRegisterOTP(e) {
    e.preventDefault();
    const name = document.getElementById('registerName').value;
    const phone = document.getElementById('registerPhone').value;
    const role = document.getElementById('registerRole').value;
    
    if (phone.length !== 10) {
      alert('Please enter a valid 10-digit phone number');
      return;
    }
    
    registerFormData = { name, phone, role };
    showLoader('registerPhoneBtn', 'registerPhoneLoader');
    
    try {
      const response = await fetch('/auth/send-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone })
      });
      
      const data = await response.json();
      
      if (data.success) {
        document.getElementById('registerPhoneDisplay').textContent = '+91 ' + phone;
        document.getElementById('registerPhoneStep').classList.remove('active');
        document.getElementById('registerOtpStep').classList.add('active');
        startOTPTimer('registerOtpTimer', 'registerResendBtn', 30);
        document.querySelector('#registerOtpStep .otp-digit').focus();
      } else {
        alert(data.message || 'Failed to send OTP. Please try again.');
      }
    } catch (error) {
      console.error('Error:', error);
      alert('An error occurred. Please try again.');
    } finally {
      hideLoader('registerPhoneBtn', 'registerPhoneLoader');
    }
  }
  
  async function verifyRegisterOTP(e) {
    e.preventDefault();
    const otpInputs = document.querySelectorAll('#registerOtpStep .otp-digit');
    const otp = Array.from(otpInputs).map(input => input.value).join('');
    
    if (otp.length !== 6) {
      alert('Please enter the 6-digit OTP');
      return;
    }
    
    showLoader('registerOtpBtn', 'registerOtpLoader');
    
    try {
      const response = await fetch('/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...registerFormData, otp })
      });
      
      const data = await response.json();
      
      if (data.success) {
        alert('Registration successful!');
        closeRegisterModal();
        location.reload();
      } else {
        alert(data.message || 'Invalid OTP. Please try again.');
        otpInputs.forEach(input => input.value = '');
        otpInputs[0].focus();
      }
    } catch (error) {
      console.error('Error:', error);
      alert('An error occurred. Please try again.');
    } finally {
      hideLoader('registerOtpBtn', 'registerOtpLoader');
    }
  }
  
  function changeRegisterNumber() {
    document.getElementById('registerOtpStep').classList.remove('active');
    document.getElementById('registerPhoneStep').classList.add('active');
    clearInterval(registerOtpTimer);
  }
  
  async function resendRegisterOTP() {
    await sendRegisterOTP({ preventDefault: () => {} });
  }
  
  // Helper Functions
  function showLoader(btnId, loaderId) {
    document.getElementById(btnId).style.display = 'none';
    document.getElementById(loaderId).style.display = 'inline-block';
  }
  
  function hideLoader(btnId, loaderId) {
    document.getElementById(btnId).style.display = 'inline-block';
    document.getElementById(loaderId).style.display = 'none';
  }
  
  function startOTPTimer(timerId, resendBtnId, seconds) {
    let timeLeft = seconds;
    const timerEl = document.getElementById(timerId);
    const resendBtn = document.getElementById(resendBtnId);
    
    timerEl.style.display = 'inline';
    resendBtn.style.display = 'none';
    
    const timer = setInterval(() => {
      timeLeft--;
      timerEl.querySelector('strong').textContent = timeLeft;
      
      if (timeLeft <= 0) {
        clearInterval(timer);
        timerEl.style.display = 'none';
        resendBtn.style.display = 'inline-block';
      }
    }, 1000);
    
    if (timerId === 'loginOtpTimer') loginOtpTimer = timer;
    else registerOtpTimer = timer;
  }
</script>
