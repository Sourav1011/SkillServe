      <!-- Phone Input Step (Hidden - OTP not available) -->
      <div id="registerPhoneStep" class="auth-step" style="display: none;">
        <form id="registerPhoneForm" onsubmit="sendRegisterOTP(event)">
          <div class="form-group">
            <label for="registerName">Full Name</label>
            <input 
              type="text" 
              id="registerName" 
              name="name" 
              placeholder="Enter your full name"
              autocomplete="name"
            >
          </div>
          
          <div class="form-group">
            <label for="registerPhone">Phone Number</label>
            <div class="phone-input-wrapper">
              <span class="country-code">+91</span>
              <input 
                type="tel" 
                id="registerPhone" 
                name="phone" 
                placeholder="Enter 10-digit mobile number"
                pattern="[0-9]{10}"
                maxlength="10"
                autocomplete="tel"
              >
            </div>
            <small class="form-hint">We'll send you a verification code</small>
          </div>
          
          <div class="form-group">
            <label for="registerRole">I am a</label>
            <select id="registerRole" name="role">
              <option value="customer">Customer</option>
              <option value="professional">Service Professional</option>
            </select>
          </div>
          
          <button type="submit" class="btn btn-primary btn-block">
            <span id="registerPhoneBtn">Send OTP</span>
            <span id="registerPhoneLoader" class="btn-loader" style="display: none;">
              <i class="fas fa-spinner fa-spin"></i> Sending...
            </span>
          </button>
        </form>
      </div>
      
      <!-- OTP Verification Step -->
      <div id="registerOtpStep" class="auth-step">
        <div class="otp-sent-message">
          <i class="fas fa-mobile-alt"></i>
          <p>OTP sent to <strong id="registerPhoneDisplay"></strong></p>
          <button class="change-number-btn" onclick="changeRegisterNumber()">
            <i class="fas fa-edit"></i> Change
          </button>
        </div>
        
        <form id="registerOtpForm" onsubmit="verifyRegisterOTP(event)">
          <div class="form-group">
            <label>Enter OTP</label>
            <div class="otp-input-group">
              <input type="text" class="otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="one-time-code" />
              <input type="text" class="otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" />
              <input type="text" class="otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" />
              <input type="text" class="otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" />
              <input type="text" class="otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" />
              <input type="text" class="otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" />
            </div>
          </div>
          
          <div class="resend-wrapper">
            <span id="registerOtpTimer" class="otp-timer">Resend OTP in <strong>30</strong>s</span>
            <button type="button" id="registerResendBtn" class="resend-btn" onclick="resendRegisterOTP()" style="display: none;">
              Resend OTP
            </button>
          </div>
          
          <button type="submit" class="btn btn-primary btn-block">
            <span id="registerOtpBtn">Verify & Register</span>
            <span id="registerOtpLoader" class="btn-loader" style="display: none;">
              <i class="fas fa-spinner fa-spin"></i> Verifying...
            </span>
          </button>
        </form>
      </div>
    </div>
    
    <div class="auth-modal-footer">
      <p>Already have an account? <a href="#" onclick="switchToLogin(); return false;">Login</a></p>
    </div>
  </div>
</div>

