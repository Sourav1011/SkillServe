<!-- Login Modal -->
<div id="loginModal" class="auth-modal">
  <div class="auth-modal-overlay" onclick="closeLoginModal()"></div>
  <div class="auth-modal-content">
    <button class="auth-modal-close" onclick="closeLoginModal()">
      <i class="fas fa-times"></i>
    </button>
    
    <div class="auth-modal-header">
      <h2>Welcome Back</h2>
      <p>Login with your email and password</p>
    </div>
    
    <div class="auth-modal-body">
      <!-- Email/Password Login Step -->
      <div id="loginEmailStep" class="auth-step active">
        <form action="/auth/login" method="POST">
          <div class="form-group">
            <label for="loginEmail">Email Address</label>
            <input 
              type="email" 
              id="loginEmail" 
              name="email" 
              placeholder="Enter your email"
              required
              autocomplete="email"
              class="form-control"
            >
          </div>
          
          <div class="form-group">
            <label for="loginPassword">Password</label>
            <input 
              type="password" 
              id="loginPassword" 
              name="password" 
              placeholder="Enter your password"
              required
              autocomplete="current-password"
              class="form-control"
            >
          </div>
          
          <div class="form-group" style="margin-bottom: 1rem;">
            <small class="form-hint" style="color: #666;">
              <strong>Test Accounts:</strong><br>
              Customer: customer@example.com / customer123<br>
              Professional: professional@example.com / professional123<br>
              Admin: admin@skillserve.com / admin123
            </small>
          </div>
          
          <button type="submit" class="btn btn-primary btn-block">
            <i class="fas fa-sign-in-alt"></i> Login
          </button>
        </form>
      </div>
      
      <!-- Phone Input Step (Hidden - OTP not available) -->
      <div id="loginPhoneStep" class="auth-step" style="display: none;">
        <form id="loginPhoneForm" onsubmit="sendLoginOTP(event)">
          <div class="form-group">
            <label for="loginPhone">Phone Number</label>
            <div class="phone-input-wrapper">
              <span class="country-code">+91</span>
              <input 
                type="tel" 
                id="loginPhone" 
                name="phone" 
                placeholder="Enter 10-digit mobile number"
                pattern="[0-9]{10}"
                maxlength="10"
                autocomplete="tel"
              >
            </div>
            <small class="form-hint">We'll send you a verification code</small>
          </div>
          
          <button type="submit" class="btn btn-primary btn-block">
            <span id="loginPhoneBtn">Send OTP</span>
            <span id="loginPhoneLoader" class="btn-loader" style="display: none;">
              <i class="fas fa-spinner fa-spin"></i> Sending...
            </span>
          </button>
        </form>
      </div>
      
      <!-- OTP Verification Step -->
      <div id="loginOtpStep" class="auth-step">
        <div class="otp-sent-message">
          <i class="fas fa-mobile-alt"></i>
          <p>OTP sent to <strong id="loginPhoneDisplay"></strong></p>
          <button class="change-number-btn" onclick="changeLoginNumber()">
            <i class="fas fa-edit"></i> Change
          </button>
        </div>
        
        <form id="loginOtpForm" onsubmit="verifyLoginOTP(event)">
          <div class="form-group">
            <label>Enter OTP</label>
            <div class="otp-input-group">
              <input type="text" class="otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="one-time-code" />
              <input type="text" class="otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" />
              <input type="text" class="otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" />
              <input type="text" class="otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" />
              <input type="text" class="otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" />
              <input type="text" class="otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" />
            </div>
          </div>
          
          <div class="resend-wrapper">
            <span id="loginOtpTimer" class="otp-timer">Resend OTP in <strong>30</strong>s</span>
            <button type="button" id="loginResendBtn" class="resend-btn" onclick="resendLoginOTP()" style="display: none;">
              Resend OTP
            </button>
          </div>
          
          <button type="submit" class="btn btn-primary btn-block">
            <span id="loginOtpBtn">Verify & Login</span>
            <span id="loginOtpLoader" class="btn-loader" style="display: none;">
              <i class="fas fa-spinner fa-spin"></i> Verifying...
            </span>
          </button>
        </form>
      </div>
    </div>
    
    <div class="auth-modal-footer">
      <p>New to SkillServe? <a href="#" onclick="switchToRegister(); return false;">Create Account</a></p>
    </div>
  </div>
</div>

<!-- Register Modal -->
<div id="registerModal" class="auth-modal">
  <div class="auth-modal-overlay" onclick="closeRegisterModal()"></div>
  <div class="auth-modal-content">
    <button class="auth-modal-close" onclick="closeRegisterModal()">
      <i class="fas fa-times"></i>
    </button>
    
    <div class="auth-modal-header">
      <h2>Create Account</h2>
      <p>Join thousands of happy customers</p>
    </div>
    
    <div class="auth-modal-body">
      <!-- Email/Password Registration -->
      <div id="registerEmailStep" class="auth-step active">
        <form action="/auth/register-email" method="POST">
          <div class="form-group">
            <label for="registerName">Full Name</label>
            <input 
              type="text" 
