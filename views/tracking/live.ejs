<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Skill Serve</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <style>
    #trackingMap {
      height: 500px;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.1);
      margin: 20px 0;
    }
    .tracking-info {
      background: white;
      padding: 24px;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.1);
      margin: 20px 0;
    }
    .status-badge {
      display: inline-block;
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 14px;
      font-weight: 600;
    }
    .status-badge.on-the-way {
      background: #fef3c7;
      color: #92400e;
    }
    .status-badge.reached {
      background: #dcfce7;
      color: #166534;
    }
    .status-badge.working {
      background: #dbeafe;
      color: #1e40af;
    }
    .professional-info {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 20px;
      background: #f9fafb;
      border-radius: 8px;
      margin: 20px 0;
    }
    .professional-info img {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      object-fit: cover;
    }
    .action-buttons {
      display: flex;
      gap: 12px;
      margin-top: 20px;
    }
    .btn-call {
      background: #10b981;
      color: white;
      padding: 12px 24px;
      border-radius: 8px;
      text-decoration: none;
      display: inline-block;
    }
    .btn-chat {
      background: #6366f1;
      color: white;
      padding: 12px 24px;
      border-radius: 8px;
      text-decoration: none;
      display: inline-block;
    }
  </style>
</head>
<body>
  <%- include('../partials/header') %>

  <div class="container">
    <h1><%= title %></h1>
    
    <div class="tracking-info">
      <div class="professional-info">
        <img src="<%= booking.professional.profileImage %>" alt="<%= booking.professional.name %>">
        <div style="flex: 1;">
          <h3 style="margin: 0 0 8px 0;"><%= booking.professional.name %></h3>
          <p style="margin: 0; color: #666;"><%= booking.service.name %></p>
        </div>
        <div style="text-align: right;">
          <div id="trackingStatus" class="status-badge">
            <%= location ? (location.status === 'on-the-way' ? 'On the way' : 
                           location.status === 'reached' ? 'Arrived' : 
                           location.status === 'working' ? 'Service in progress' : 'Updating...') : 'Updating...' %>
          </div>
          <div style="margin-top: 8px; font-size: 14px; color: #666;">
            <div id="eta"><%= location && location.eta ? 'ETA: ' + new Date(location.eta).toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'}) : '' %></div>
            <div id="distance"><%= location && location.distance ? location.distance.toFixed(1) + ' km away' : '' %></div>
          </div>
        </div>
      </div>

      <div id="trackingMap"></div>

      <div class="action-buttons">
        <a href="tel:<%= booking.professional.phone %>" class="btn-call">📞 Call Professional</a>
        <a href="/chat?bookingId=<%= booking._id %>" class="btn-chat">💬 Chat</a>
      </div>
    </div>

    <div id="trackingContainer" 
         data-booking-id="<%= booking._id %>"
         style="display: none;">
    </div>
    
    <input type="hidden" id="customerLat" value="<%= booking.address ? '28.6139' : '28.6139' %>">
    <input type="hidden" id="customerLng" value="<%= booking.address ? '77.2090' : '77.2090' %>">
    <input type="hidden" id="professionalPhone" value="<%= booking.professional.phone %>">
    <input type="hidden" id="chatId" value="">
  </div>

  <%- include('../partials/footer') %>
  <script src="/socket.io/socket.io.js"></script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="/js/tracking.js"></script>
  <script src="/js/notifications.js"></script>
  <script src="/js/chatbot-widget.js"></script>
  <input type="hidden" id="currentUserId" value="<%= user._id %>">
</body>
</html>
