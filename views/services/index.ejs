<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <%- include('../partials/header') %>
  
  <% if (success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>
  
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>
  
  <div class="container">
    <div class="page-header">
      <h1>Our Services</h1>
    </div>
    
    <!-- Category Filter -->
    <div class="category-filter">
      <a href="/services" class="category-btn <%= selectedCategory === 'All' ? 'active' : '' %>">All</a>
      <% categories.forEach(category => { %>
        <a href="/services?category=<%= category %>" class="category-btn <%= selectedCategory === category ? 'active' : '' %>">
          <%= category %>
        </a>
      <% }); %>
    </div>
    
    <!-- Services Grid -->
    <div class="services-grid">
      <% if (services.length > 0) { %>
        <% services.forEach(service => { %>
          <div class="service-card">
            <img src="<%= service.image %>" alt="<%= service.name %>">
            <div class="service-content">
              <span class="service-category"><%= service.category %></span>
              <h3><%= service.name %></h3>
              <p><%= service.description.substring(0, 100) %>...</p>
              <div class="service-meta">
                <span><i class="fas fa-clock"></i> <%= service.duration %> mins</span>
              </div>
              <div class="service-footer">
                <span class="price">₹<%= service.price %></span>
                <a href="/services/<%= service._id %>" class="btn btn-small">View Details</a>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <p class="no-results">No services found in this category.</p>
      <% } %>
    </div>
  </div>
  
  <%- include('../partials/footer') %>
  
  <script src="/js/main.js"></script>
</body>
</html>
