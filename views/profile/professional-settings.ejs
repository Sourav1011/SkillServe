<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile Settings | SkillServe Pro</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --primary: #2E3192;
      --primary-dark: #1f2163;
      --secondary: #00D4FF;
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
      --info: #3b82f6;
      --light: #f8f9fa;
      --dark: #1f2937;
      --sidebar-width: 260px;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #f3f4f6;
      margin: 0;
    }

    .pro-container {
      display: flex;
      min-height: 100vh;
    }

    /* Professional Sidebar */
    .pro-sidebar {
      width: var(--sidebar-width);
      background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%);
      color: white;
      position: fixed;
      height: 100vh;
      overflow-y: auto;
      z-index: 1000;
      box-shadow: 2px 0 10px rgba(0,0,0,0.1);
    }

    .pro-logo {
      padding: 2rem 1.5rem;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      text-align: center;
    }

    .pro-logo h2 {
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
    }

    .pro-logo p {
      font-size: 0.875rem;
      opacity: 0.8;
    }

    .pro-nav {
      padding: 1rem 0;
    }

    .nav-item {
      display: flex;
      align-items: center;
      padding: 0.875rem 1.5rem;
      color: rgba(255,255,255,0.8);
      text-decoration: none;
      transition: all 0.3s;
      border-left: 3px solid transparent;
    }

    .nav-item:hover {
      background: rgba(255,255,255,0.1);
      color: white;
      border-left-color: var(--secondary);
    }

    .nav-item.active {
      background: rgba(255,255,255,0.15);
      color: white;
      border-left-color: var(--secondary);
    }

    .nav-item i {
      width: 20px;
      margin-right: 0.875rem;
      font-size: 1.1rem;
    }

    /* Main Content */
    .pro-main {
      margin-left: var(--sidebar-width);
      flex: 1;
      padding: 2rem;
    }

    .page-header {
      margin-bottom: 2rem;
    }

    .page-header h1 {
      font-size: 2rem;
      color: var(--dark);
      margin-bottom: 0.5rem;
    }

    .page-header p {
      color: #6b7280;
      font-size: 1rem;
    }

    /* Settings Card */
    .settings-card {
      background: white;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      margin-bottom: 2rem;
    }

    .settings-card-header {
      padding: 1.5rem 2rem;
      border-bottom: 1px solid #e5e7eb;
    }

    .settings-card-header h2 {
      font-size: 1.25rem;
      color: var(--dark);
      margin: 0;
    }

    .settings-card-body {
      padding: 2rem;
    }

    /* Form Styles */
    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-group label {
      display: block;
      font-weight: 600;
      color: var(--dark);
      margin-bottom: 0.5rem;
      font-size: 0.95rem;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font-size: 0.95rem;
      transition: all 0.3s;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(46, 49, 146, 0.1);
    }

    .form-group textarea {
      resize: vertical;
      min-height: 100px;
    }

    .form-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
    }

    /* Profile Image Upload */
    .profile-image-upload {
      display: flex;
      align-items: center;
      gap: 2rem;
      margin-bottom: 2rem;
    }

    .profile-image-preview {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      object-fit: cover;
      border: 4px solid var(--primary);
    }

    .upload-btn-wrapper {
      position: relative;
      overflow: hidden;
      display: inline-block;
    }

    .upload-btn {
      background: var(--primary);
      color: white;
      padding: 0.75rem 1.5rem;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      border: none;
      transition: all 0.3s;
    }

    .upload-btn:hover {
      background: var(--primary-dark);
    }

    .upload-btn-wrapper input[type=file] {
      position: absolute;
      left: 0;
      top: 0;
      opacity: 0;
      cursor: pointer;
      width: 100%;
      height: 100%;
    }

    /* Service Categories */
    .service-categories-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1rem;
    }

    .category-checkbox {
      display: flex;
      align-items: center;
      padding: 1rem;
      border: 2px solid #e5e7eb;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.3s;
    }

    .category-checkbox:hover {
      border-color: var(--primary);
      background: rgba(46, 49, 146, 0.05);
    }

    .category-checkbox input[type="checkbox"] {
      width: 18px;
      height: 18px;
      margin-right: 0.75rem;
      cursor: pointer;
    }

    .category-checkbox input[type="checkbox"]:checked + label {
      color: var(--primary);
      font-weight: 600;
    }

    .category-checkbox.checked {
      border-color: var(--primary);
      background: rgba(46, 49, 146, 0.1);
    }

    /* Buttons */
    .btn-primary {
      background: var(--primary);
      color: white;
      padding: 0.875rem 2rem;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 1rem;
      cursor: pointer;
      transition: all 0.3s;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-primary:hover {
      background: var(--primary-dark);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(46, 49, 146, 0.3);
    }

    .btn-secondary {
      background: #6b7280;
      color: white;
      padding: 0.875rem 2rem;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 1rem;
      cursor: pointer;
      transition: all 0.3s;
      margin-left: 1rem;
    }

    .btn-secondary:hover {
      background: #4b5563;
    }

    .form-actions {
      display: flex;
      justify-content: flex-end;
      margin-top: 2rem;
      padding-top: 2rem;
      border-top: 1px solid #e5e7eb;
    }

    /* Experience Slider */
    .experience-slider {
      width: 100%;
    }

    .experience-value {
      display: inline-block;
      background: var(--primary);
      color: white;
      padding: 0.25rem 0.75rem;
      border-radius: 20px;
      font-weight: 600;
      margin-left: 0.5rem;
    }
  </style>
</head>
<body>
  <!-- Hidden user data for Socket.IO -->
  <div id="userData" data-user-id="<%= user._id %>" data-user-role="<%= user.role %>" style="display: none;"></div>

  <div class="pro-container">
    <!-- Professional Sidebar -->
    <div class="pro-sidebar">
      <div class="pro-logo">
        <h2><i class="fas fa-user-tie"></i> SkillServe Pro</h2>
        <p>Professional Portal</p>
      </div>

      <nav class="pro-nav">
        <a href="/profile/professional" class="nav-item">
          <i class="fas fa-th-large"></i>
          <span>Dashboard</span>
        </a>
        <a href="/profile/professional/bookings" class="nav-item">
          <i class="fas fa-calendar-check"></i>
          <span>My Bookings</span>
        </a>
        <a href="/profile/professional/earnings" class="nav-item">
          <i class="fas fa-rupee-sign"></i>
          <span>Earnings</span>
        </a>
        <a href="/profile/professional/settings" class="nav-item active">
          <i class="fas fa-user-cog"></i>
          <span>Profile Settings</span>
        </a>
        <a href="/profile/professional/availability" class="nav-item">
          <i class="fas fa-clock"></i>
          <span>Availability</span>
        </a>
        <a href="/profile/professional/reviews" class="nav-item">
          <i class="fas fa-star"></i>
          <span>Reviews</span>
        </a>
        <a href="/" class="nav-item" style="margin-top: 2rem; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1rem;">
          <i class="fas fa-arrow-left"></i>
          <span>Back to Site</span>
        </a>
        <a href="/auth/logout" class="nav-item">
          <i class="fas fa-sign-out-alt"></i>
          <span>Logout</span>
        </a>
      </nav>
    </div>

    <!-- Main Content -->
    <div class="pro-main">
      <div class="page-header">
        <h1><i class="fas fa-user-cog"></i> Profile Settings</h1>
        <p>Update your professional profile information</p>
      </div>

      <form action="/profile/update" method="POST" enctype="multipart/form-data" id="profileForm">
        <!-- Personal Information -->
        <div class="settings-card">
          <div class="settings-card-header">
            <h2><i class="fas fa-user"></i> Personal Information</h2>
          </div>
          <div class="settings-card-body">
            <div class="profile-image-upload">
              <img src="<%= user.profileImage %>" alt="Profile" class="profile-image-preview" id="imagePreview">
              <div>
                <div class="upload-btn-wrapper">
                  <button class="upload-btn" type="button">
                    <i class="fas fa-camera"></i>
                    Change Profile Picture
                  </button>
                  <input type="file" name="profileImage" accept="image/*" onchange="previewImage(event)">
                </div>
                <p style="color: #6b7280; font-size: 0.875rem; margin-top: 0.5rem;">
                  JPG, PNG or GIF. Max size 2MB.
                </p>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="name">Full Name *</label>
                <input type="text" id="name" name="name" value="<%= user.name %>" required>
              </div>

              <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" value="<%= user.email %>" disabled style="background: #f3f4f6;">
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="phone">Phone Number *</label>
                <input type="tel" id="phone" name="phone" value="<%= user.phone %>" required>
              </div>

              <div class="form-group">
                <label for="profession">Profession Title *</label>
                <input type="text" id="profession" name="profession" value="<%= user.profession || '' %>" 
                       placeholder="e.g., Home Cleaning Expert, Plumber, Electrician" required>
              </div>
            </div>

            <div class="form-group">
              <label for="experience">
                Years of Experience: <span class="experience-value" id="experienceValue"><%= user.experience || 0 %></span>
              </label>
              <input type="range" id="experience" name="experience" min="0" max="30" 
                     value="<%= user.experience || 0 %>" class="experience-slider" 
                     oninput="document.getElementById('experienceValue').textContent = this.value">
            </div>
          </div>
        </div>

        <!-- Service Categories -->
        <div class="settings-card">
          <div class="settings-card-header">
            <h2><i class="fas fa-briefcase"></i> Service Categories</h2>
          </div>
          <div class="settings-card-body">
            <p style="color: #6b7280; margin-bottom: 1.5rem;">
              Select the service categories you can provide
            </p>
            <div class="service-categories-grid">
              <% const categories = ['Home Cleaning', 'Salon', 'Appliance Repair', 'Painting', 'Plumbing', 'Electrical', 'Carpentry', 'Pest Control', 'AC Repair', 'Other']; %>
              <% categories.forEach(function(category) { %>
                <label class="category-checkbox <%= user.serviceCategories && user.serviceCategories.includes(category) ? 'checked' : '' %>">
                  <input type="checkbox" name="serviceCategories" value="<%= category %>" 
                         <%= user.serviceCategories && user.serviceCategories.includes(category) ? 'checked' : '' %>
                         onchange="this.parentElement.classList.toggle('checked', this.checked)">
                  <label><%= category %></label>
                </label>
              <% }); %>
            </div>
          </div>
        </div>

        <!-- Address Information -->
        <div class="settings-card">
          <div class="settings-card-header">
            <h2><i class="fas fa-map-marker-alt"></i> Address Information</h2>
          </div>
          <div class="settings-card-body">
            <div class="form-group">
              <label for="street">Street Address</label>
              <input type="text" id="street" name="street" value="<%= user.address?.street || '' %>" 
                     placeholder="House no., Building name">
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="city">City</label>
                <input type="text" id="city" name="city" value="<%= user.address?.city || '' %>" placeholder="City">
              </div>

              <div class="form-group">
                <label for="state">State</label>
                <input type="text" id="state" name="state" value="<%= user.address?.state || '' %>" placeholder="State">
              </div>

              <div class="form-group">
                <label for="zipCode">Pin Code</label>
                <input type="text" id="zipCode" name="zipCode" value="<%= user.address?.zipCode || '' %>" placeholder="123456">
              </div>
            </div>
          </div>
        </div>

        <!-- Form Actions -->
        <div class="form-actions">
          <button type="button" class="btn-secondary" onclick="window.location.href='/profile/professional'">
            Cancel
          </button>
          <button type="submit" class="btn-primary">
            <i class="fas fa-save"></i>
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function previewImage(event) {
      const file = event.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          document.getElementById('imagePreview').src = e.target.result;
        };
        reader.readAsDataURL(file);
      }
    }

    // Form submission with validation
    document.getElementById('profileForm').addEventListener('submit', function(e) {
      const categories = document.querySelectorAll('input[name="serviceCategories"]:checked');
      if (categories.length === 0) {
        e.preventDefault();
        alert('Please select at least one service category');
        return false;
      }
    });
  </script>

  <%- include('../../partials/footer') %>
</body>
</html>
